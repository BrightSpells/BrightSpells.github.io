# macOS metadata
.DS_Store
**/.DS_Store

# Hugo-generated output and caches
/public/
/resources/_gen/
/.hugo_build.lock

# Generated from Git history before each build
/data/gitdates.json

# Local Python cache files
__pycache__/
*.py[cod]

# Local NeoDB credential (GitHub Actions uses the NEODB_TOKEN secret instead)
/.neodb-token

# Full local font sources; the site publishes only optimized WOFF2 subsets
/static/fonts/SourceHanSerifSC-Regular.otf
/static/fonts/SourceSerif4-Regular.ttf
